<?xml version="1.0" encoding="utf-8"?>
<!--
  Кнопка настроек Material 3 Expressive — капсула со скруглением large,
  заливка поверхности, обводка outline, фокус-состояние для пульта.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/m3ColorPrimaryFixedDim" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="?attr/m3ColorPrimary" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/m3ColorPrimaryFixedDim" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/m3ColorSurfaceContainer" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="?attr/m3ColorOutlineVariant" />
        </shape>
    </item>
</selector>
