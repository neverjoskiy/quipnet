<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 Expressive Card — выраженная тень, большой скруглённый угол, обводка. -->
<shape android:shape="rectangle" xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="?attr/m3ColorSurfaceContainer" />
    <corners android:radius="16dp" />
    <stroke android:width="1dp" android:color="?attr/m3ColorOutlineVariant" />
<shadow
    android:radius="12dp"
    android:color="#4D000000" />
</shape>
