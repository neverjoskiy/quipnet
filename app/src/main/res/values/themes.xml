<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ========================================================================
         Material 3 Expressive — базовая тема приложения.
         Родитель: Theme.Material3.DayNight.NoActionBar (Material 3, не Material 2).
         Цвета берутся из tonal palette colors.xml (m3_*). Формы — small/medium/large
         скругления. Elevation — выраженные ступени 0..12 dp. Типографика — type scale
         Material 3 Expressive (display/headline/title/body/label).
         ======================================================================== -->
    <style name="Theme.QuipNet" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Материал 3 — основные роли цвета -->
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_onPrimary</item>
        <item name="colorPrimaryContainer">@color/m3_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/m3_onPrimaryContainer</item>
        <item name="colorSecondary">@color/m3_secondary</item>
        <item name="colorOnSecondary">@color/m3_onSecondary</item>
        <item name="colorSecondaryContainer">@color/m3_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/m3_onSecondaryContainer</item>
        <item name="colorTertiary">@color/m3_tertiary</item>
        <item name="colorOnTertiary">@color/m3_onTertiary</item>
        <item name="colorTertiaryContainer">@color/m3_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/m3_onTertiaryContainer</item>
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_onError</item>
        <item name="colorErrorContainer">@color/m3_errorContainer</item>
        <item name="colorOnErrorContainer">@color/m3_onErrorContainer</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outlineVariant</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_onSurface</item>
        <item name="colorSurfaceDim">@color/m3_surfaceDim</item>
        <item name="colorSurfaceBright">@color/m3_surfaceBright</item>
        <item name="colorSurfaceContainer">@color/m3_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/m3_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/m3_surfaceContainerHighest</item>
        <item name="colorBackground">@color/m3_background</item>
        <item name="colorOnBackground">@color/m3_onBackground</item>

        <!-- Материал 3 Expressive — кастомные роли m3Color* для разметки.
             Разметка ссылается на ?attr/m3Color*, а не на color*,
             поэтому значения нужно задать явно. -->
        <item name="m3ColorPrimary">@color/m3_primary</item>
        <item name="m3ColorOnPrimary">@color/m3_onPrimary</item>
        <item name="m3ColorPrimaryContainer">@color/m3_primaryContainer</item>
        <item name="m3ColorOnPrimaryContainer">@color/m3_onPrimaryContainer</item>
        <item name="m3ColorPrimaryFixed">@color/m3_primaryFixed</item>
        <item name="m3ColorPrimaryFixedDim">@color/m3_primaryFixedDim</item>
        <item name="m3ColorOnPrimaryFixed">@color/m3_onPrimaryFixed</item>
        <item name="m3ColorOnPrimaryFixedVariant">@color/m3_onPrimaryFixedVariant</item>

        <item name="m3ColorSecondary">@color/m3_secondary</item>
        <item name="m3ColorOnSecondary">@color/m3_onSecondary</item>
        <item name="m3ColorSecondaryContainer">@color/m3_secondaryContainer</item>
        <item name="m3ColorOnSecondaryContainer">@color/m3_onSecondaryContainer</item>
        <item name="m3ColorSecondaryFixed">@color/m3_secondaryFixed</item>
        <item name="m3ColorSecondaryFixedDim">@color/m3_secondaryFixedDim</item>
        <item name="m3ColorOnSecondaryFixed">@color/m3_onSecondaryFixed</item>
        <item name="m3ColorOnSecondaryFixedVariant">@color/m3_onSecondaryFixedVariant</item>

        <item name="m3ColorTertiary">@color/m3_tertiary</item>
        <item name="m3ColorOnTertiary">@color/m3_onTertiary</item>
        <item name="m3ColorTertiaryContainer">@color/m3_tertiaryContainer</item>
        <item name="m3ColorOnTertiaryContainer">@color/m3_onTertiaryContainer</item>

        <item name="m3ColorError">@color/m3_error</item>
        <item name="m3ColorOnError">@color/m3_onError</item>
        <item name="m3ColorErrorContainer">@color/m3_errorContainer</item>
        <item name="m3ColorOnErrorContainer">@color/m3_onErrorContainer</item>

        <item name="m3ColorOutline">@color/m3_outline</item>
        <item name="m3ColorOutlineVariant">@color/m3_outlineVariant</item>

        <item name="m3ColorInverseSurface">@color/m3_inverseSurface</item>
        <item name="m3ColorInverseOnSurface">@color/m3_inverseOnSurface</item>
        <item name="m3ColorInversePrimary">@color/m3_inversePrimary</item>

        <item name="m3ColorSurface">@color/m3_surface</item>
        <item name="m3ColorSurfaceDim">@color/m3_surfaceDim</item>
        <item name="m3ColorSurfaceBright">@color/m3_surfaceBright</item>
        <item name="m3ColorSurfaceContainer">@color/m3_surfaceContainer</item>
        <item name="m3ColorSurfaceContainerHigh">@color/m3_surfaceContainerHigh</item>
        <item name="m3ColorSurfaceContainerHighest">@color/m3_surfaceContainerHighest</item>

        <item name="m3ColorBackground">@color/m3_background</item>
        <item name="m3ColorOnBackground">@color/m3_onBackground</item>

        <!-- Scarf — дополнительный экспрессивный акцент (золотой) -->
        <item name="m3ColorScarf">@color/m3_scarf</item>
        <item name="m3ColorOnScarf">@color/m3_onScarf</item>
        <item name="m3ColorScarfContainer">@color/m3_scarfContainer</item>
        <item name="m3ColorOnScarfContainer">@color/m3_onScarfContainer</item>

        <!-- Оттенок иконок -->
        <item name="m3ColorIconTint">@color/m3_onPrimaryContainer</item>

        <!-- Старые роли для совместимости с кастомными View -->
        <item name="colorPrimaryVariant">@color/m3_primary</item>
        <item name="colorSecondaryVariant">@color/m3_secondary</item>

        <!-- Статус-бар: полупрозрачный тёмный, контент заходит под него (edge-to-edge) -->
        <item name="android:statusBarColor">#22000000</item>
        <item name="android:navigationBarColor">@color/m3_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>

        <!-- Фон окна — без него на старте может быть чёрный/белый экран до инфляции разметки. -->
        <item name="android:windowBackground">@color/m3_surface</item>

        <!-- Формы Material 3 Expressive: скругления small/medium/large -->
        <item name="shapeSmall">4dp</item>
        <item name="shapeMedium">8dp</item>
        <item name="shapeLarge">12dp</item>
        <item name="shapeExtraLarge">28dp</item>

        <!-- Элевация Material 3 Expressive: выраженные ступени -->
        <item name="elevationLevel0">0dp</item>
        <item name="elevationLevel1">1dp</item>
        <item name="elevationLevel2">2dp</item>
        <item name="elevationLevel3">3dp</item>
        <item name="elevationLevel4">4dp</item>
        <item name="elevationLevel8">8dp</item>
        <item name="elevationLevel12">12dp</item>

        <!-- Анимация окон Material 3 Expressive: плавные переходы между экранами -->
        <item name="android:windowAnimationStyle">@style/AnimationQuipNet</item>

        <!-- Типографика Material 3 Expressive — type scale -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.QuipNet.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.QuipNet.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.QuipNet.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.QuipNet.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.QuipNet.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.QuipNet.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.QuipNet.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.QuipNet.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.QuipNet.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.QuipNet.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.QuipNet.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.QuipNet.LabelSmall</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.QuipNet.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.QuipNet.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.QuipNet.DisplaySmall</item>
    </style>

    <!-- ========================================================================
         Тема экранов настроек — Material 3 Expressive.
         Наследуется от Theme.QuipNet, добавляет роли словаря темы (quipnet*).
         ======================================================================== -->
    <style name="Theme.QuipNet.Settings" parent="Theme.QuipNet">
        <item name="viewInflaterClass">com.example.quipnet.QuipNetViewInflater</item>
        <item name="android:windowIsFloating">false</item>

        <!-- Фон экрана — поверхность базового цвета -->
        <item name="android:windowBackground">@color/m3_surface</item>

        <!-- Умолчания словаря темы (Auroramint — базовый акцент изумрудный) -->
        <item name="quipnetCardBackground">@drawable/bg_quipnet_card_aurora</item>
        <item name="quipnetFieldBackground">@drawable/bg_quipnet_field_aurora</item>
        <item name="quipnetDialogButton">@drawable/bg_quipnet_dialog_button_aurora</item>
        <item name="quipnetDialogButtonPrimary">@drawable/bg_quipnet_dialog_button_primary_aurora</item>
        <item name="android:alertDialogTheme">@style/Theme.QuipNet.Dialog.Auroramint</item>
        <item name="alertDialogTheme">@style/Theme.QuipNet.Dialog.Auroramint</item>
        <item name="colorAccent">@color/m3_primary</item>
        <item name="android:colorAccent">@color/m3_primary</item>
        <item name="colorControlActivated">@color/m3_primary</item>
        <item name="android:colorControlActivated">@color/m3_primary</item>
        <item name="colorControlNormal">@color/m3_onPrimaryContainer</item>
        <item name="android:colorControlNormal">@color/m3_onPrimaryContainer</item>
        <item name="android:textColorHint">@color/m3_onPrimaryContainer</item>
        <item name="quipnetAccent">@color/m3_primary</item>
        <item name="quipnetAccentDim">@color/m3_primary_tone_30</item>
        <item name="quipnetAccentOn">@color/m3_onPrimary</item>
        <item name="quipnetSeparator">@color/m3_outline</item>
        <item name="quipnetTextGroupFrom">@color/m3_primary_tone_50</item>
        <item name="quipnetTextGroupTo">@color/m3_primary_tone_80</item>
        <item name="quipnetTextTitle">@color/m3_onBackground</item>
        <item name="quipnetTextValue">@color/m3_onPrimaryContainer</item>
        <item name="quipnetTextHint">@color/m3_onPrimaryContainer</item>
        <item name="quipnetSwitchOn">@color/m3_primary</item>
        <item name="quipnetSwitchOff">@color/m3_outlineVariant</item>
        <item name="quipnetSwitchThumbOn">@color/m3_onPrimary</item>
        <item name="quipnetSwitchThumbOff">@color/m3_onBackground</item>
        <item name="quipnetIconTint">@color/m3_onPrimaryContainer</item>
        <item name="quipnetCardFill">@color/m3_surfaceContainer</item>
        <item name="quipnetCardStroke">@color/m3_outline</item>
        <item name="quipnetFocusFill">@color/m3_primary_tone_40</item>
        <item name="quipnetFocusStroke">@color/m3_primary</item>
        <item name="switchStyle">@style/Widget.QuipNet.ExpressiveSwitch</item>
        <item name="android:switchStyle">@style/Widget.QuipNet.ExpressiveSwitch</item>
    </style>

    <!-- ========================================================================
         Переключатель Material 3 Expressive.
         Крупные пропорции, новая геометрия бегунка и трека, анимация состояний.
         ======================================================================== -->
    <style name="Widget.QuipNet.ExpressiveSwitch" parent="Widget.Material3.CompoundButton.Switch">
        <item name="track">@drawable/switch_track_expressive</item>
        <item name="android:track">@drawable/switch_track_expressive</item>
        <item name="thumbTint">@color/switch_thumb_tint_expressive</item>
        <item name="android:thumbTint">@color/switch_thumb_tint_expressive</item>
        <item name="trackTint">@color/switch_track_tint_expressive</item>
        <item name="android:trackTint">@color/switch_track_tint_expressive</item>
        <item name="showText">false</item>
        <item name="android:showText">false</item>
        <item name="android:textOn"></item>
        <item name="android:textOff"></item>
        <item name="android:switchMinWidth">56dp</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:thumbTextPadding">0dp</item>
        <item name="android:background">@null</item>
    </style>

    <!-- ========================================================================
         Типография Material 3 Expressive.
         Размеры увеличены по сравнению с базовым M3, жирные начертания,
         контрастная иерархия заголовков и текста.
         ======================================================================== -->

    <!-- Display — очень большие выразительные заголовки -->
    <style name="TextAppearance.QuipNet.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textSize">57sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineHeight">64sp</item>
    </style>
    <style name="TextAppearance.QuipNet.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textSize">45sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineHeight">52sp</item>
    </style>
    <style name="TextAppearance.QuipNet.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">36sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineHeight">44sp</item>
    </style>

    <!-- Headline — крупные заглавия экранов -->
    <style name="TextAppearance.QuipNet.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">32sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineHeight">40sp</item>
    </style>
    <style name="TextAppearance.QuipNet.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineHeight">36sp</item>
    </style>
    <style name="TextAppearance.QuipNet.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineHeight">32sp</item>
    </style>

    <!-- Title — названия секций -->
    <style name="TextAppearance.QuipNet.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:lineHeight">28sp</item>
    </style>
    <style name="TextAppearance.QuipNet.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:letterSpacing">0.015</item>
        <item name="android:lineHeight">26sp</item>
    </style>
    <style name="TextAppearance.QuipNet.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">16sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:lineHeight">24sp</item>
    </style>

    <!-- Body — основной текст -->
    <style name="TextAppearance.QuipNet.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:lineHeight">24sp</item>
    </style>
    <style name="TextAppearance.QuipNet.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:letterSpacing">0.025</item>
        <item name="android:lineHeight">20sp</item>
    </style>
    <style name="TextAppearance.QuipNet.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:lineHeight">16sp</item>
    </style>

    <!-- Label — подписи, кнопки, чипы -->
    <style name="TextAppearance.QuipNet.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:lineHeight">20sp</item>
    </style>
    <style name="TextAppearance.QuipNet.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:lineHeight">18sp</item>
    </style>
    <style name="TextAppearance.QuipNet.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:lineHeight">16sp</item>
    </style>

    <!-- ========================================================================
         Анимация переходов между Activity (Material 3 Expressive Motion).
         Плавный сдвиг + затухание, shared element-готовость.
         ======================================================================== -->
    <style name="AnimationQuipNet">
        <item name="android:activityOpenEnterAnimation">@anim/quipnet_slide_in</item>
        <item name="android:activityOpenExitAnimation">@anim/quipnet_slide_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/quipnet_slide_in</item>
        <item name="android:activityCloseExitAnimation">@anim/quipnet_slide_out</item>
    </style>

    <!-- ========================================================================
         Кастомные чипы (сохранены для совместимости, цвета — из M3 палитры).
         ======================================================================== -->
    <style name="QuipNetMainRegionChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/bg_region_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/m3_onPrimary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="QuipNetAppearanceChip" parent="QuipNetMainRegionChip">
        <item name="android:layout_height">104dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">26dp</item>
        <item name="android:paddingEnd">26dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:background">@drawable/bg_appearance_chip</item>
    </style>

    <style name="QuipNetSubRegionChip" parent="QuipNetMainRegionChip">
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:minWidth">52dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <!-- ========================================================================
         Кнопки Material 3 Expressive.
         Крупные пропорции, новый padding, скругление 28dp, elevation состояний.
         ======================================================================== -->

    <!-- Filled Button — основное действие, заполненный контейнер primary. -->
    <style name="Widget.QuipNet.Button.Filled" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/btn_expressive_filled</item>
        <item name="android:textColor">?attr/m3ColorOnPrimaryContainer</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="elevation">2dp</item>
    </style>

    <!-- Filled Tonal Button — тональный secondary container. -->
    <style name="Widget.QuipNet.Button.FilledTonal" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/btn_expressive_filled_tonal</item>
        <item name="android:textColor">?attr/m3ColorOnSecondaryContainer</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Outlined Button — обводка на прозрачном фоне. -->
    <style name="Widget.QuipNet.Button.Outlined" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/btn_expressive_outlined</item>
        <item name="android:textColor">?attr/m3ColorPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Text Button — только текст, без фона. -->
    <style name="Widget.QuipNet.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:background">@drawable/btn_expressive_text</item>
        <item name="android:textColor">?attr/m3ColorPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Elevated Button — с тенью, для важных действий. -->
    <style name="Widget.QuipNet.Button.Elevated" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/btn_expressive_filled</item>
        <item name="android:textColor">?attr/m3ColorOnPrimaryContainer</item>
