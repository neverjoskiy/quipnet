<?xml version="1.0" encoding="utf-8"?>
<!--
    Словарь темы оформления — Material 3 Expressive.

    Смысл в том, чтобы разметка не знала ни одного цвета. Раньше их было 14 штук
    литералами по десяти файлам — четыре серых на одну роль, четыре зелёных на один
    акцент, семь кеглей на четыре смысла. Пока цвет прибит в разметке, «единая
    палитра» держится только на внимании, а внимание кончается на пятом экране.

    Значения приходят из `values/themes_nova.xml` (генерируется
    `tools/gen_nova_themes.py`), умолчания — из `Theme.QuipNet.Settings`, чтобы экран
    без явной темы не остался с нулями.

    Ролей текста ровно четыре, и больше заводить нельзя: пятая роль означает, что
    какая-то из четырёх используется не по назначению.
-->
<resources>

    <!-- ===== Материал 3 Expressive — поверхности ===== -->

    <!-- ===== Материал 3 Expressive — основные роли ===== -->
    <attr name="m3ColorPrimary" format="color" />
    <attr name="m3ColorOnPrimary" format="color" />
    <attr name="m3ColorPrimaryContainer" format="color" />
    <attr name="m3ColorOnPrimaryContainer" format="color" />
    <attr name="m3ColorPrimaryFixed" format="color" />
    <attr name="m3ColorPrimaryFixedDim" format="color" />
    <attr name="m3ColorOnPrimaryFixed" format="color" />
    <attr name="m3ColorOnPrimaryFixedVariant" format="color" />

    <attr name="m3ColorSecondary" format="color" />
    <attr name="m3ColorOnSecondary" format="color" />
    <attr name="m3ColorSecondaryContainer" format="color" />
    <attr name="m3ColorOnSecondaryContainer" format="color" />
    <attr name="m3ColorSecondaryFixed" format="color" />
    <attr name="m3ColorSecondaryFixedDim" format="color" />
    <attr name="m3ColorOnSecondaryFixed" format="color" />
    <attr name="m3ColorOnSecondaryFixedVariant" format="color" />

    <attr name="m3ColorTertiary" format="color" />
    <attr name="m3ColorOnTertiary" format="color" />
    <attr name="m3ColorTertiaryContainer" format="color" />
    <attr name="m3ColorOnTertiaryContainer" format="color" />

    <attr name="m3ColorError" format="color" />
    <attr name="m3ColorOnError" format="color" />
    <attr name="m3ColorErrorContainer" format="color" />
    <attr name="m3ColorOnErrorContainer" format="color" />

    <attr name="m3ColorOutline" format="color" />
    <attr name="m3ColorOutlineVariant" format="color" />

    <attr name="m3ColorInverseSurface" format="color" />
    <attr name="m3ColorInverseOnSurface" format="color" />
    <attr name="m3ColorInversePrimary" format="color" />

    <attr name="m3ColorSurface" format="color" />
    <attr name="m3ColorOnSurface" format="color" />
    <attr name="m3ColorOnSurfaceContainer" format="color" />
    <attr name="m3ColorOnSurfaceContainerHigh" format="color" />
    <attr name="m3ColorOnSurfaceContainerHighest" format="color" />
    <attr name="m3ColorSurfaceDim" format="color" />
    <attr name="m3ColorSurfaceBright" format="color" />
    <attr name="m3ColorSurfaceContainer" format="color" />
    <attr name="m3ColorSurfaceContainerHigh" format="color" />
    <attr name="m3ColorSurfaceContainerHighest" format="color" />

    <attr name="m3ColorBackground" format="color" />
    <attr name="m3ColorOnBackground" format="color" />

    <attr name="m3ColorScarf" format="color" />
    <attr name="m3ColorOnScarf" format="color" />
    <attr name="m3ColorScarfContainer" format="color" />
    <attr name="m3ColorOnScarfContainer" format="color" />

    <!-- ===== Подложки. Ссылками, а не цветами: у тем разный радиус и разная толщина
         обводки, а прямоугольные панели Path of Exile — это не «почти как у всех»,
         а то, по чему тема узнаётся. --> -->
    <!-- Выделение: заливка и обводка при фокусе пульта, нажатии и свечении под
         пальцем. Раньше на это стоял общий `@color/tv_focus_*`, то есть один и тот
         же зелёный `#32D74B` во всех десяти темах — на золотой теме долгое нажатие
         подсвечивало строку зелёным. Значения выдаёт тема, фигуры ссылаются сюда. -->
    <attr name="quipnetFocusFill" format="color" />
    <attr name="quipnetFocusStroke" format="color" />

    <attr name="quipnetCardBackground" format="reference" />
    <attr name="quipnetFieldBackground" format="reference" />

    <!-- Подложки кнопок диалога. Нужны словарём, а не только стилем: кнопки
         приходится красить кодом (`QuipNetDialogs`) — на Pixel платформенный стиль
         кнопки диалога перебивает и фон, и оттенок, заданные темой. -->
    <attr name="quipnetDialogButton" format="reference" />
    <attr name="quipnetDialogButtonPrimary" format="reference" />

    <!-- Акцент — ровно один на тему. `quipnetAccentOn` — цвет текста поверх акцента:
         на светлом акценте белые буквы пропадают. -->
    <attr name="quipnetAccent" format="color" />
    <attr name="quipnetAccentDim" format="color" />
    <attr name="quipnetAccentOn" format="color" />

    <attr name="quipnetSeparator" format="color" />
    <attr name="quipnetCardFill" format="color" />
    <attr name="quipnetCardStroke" format="color" />

    <!-- Роль A — заголовок группы. Две точки градиента: заливка идёт шейдером по
         тексту (`QuipNetTheme.paintHeading`), а не картинкой. -->
    <attr name="quipnetTextGroupFrom" format="color" />
    <attr name="quipnetTextGroupTo" format="color" />

    <!-- Роль B — название пункта. -->
    <attr name="quipnetTextTitle" format="color" />
    <!-- Роль C — значение справа и пояснения. -->
    <attr name="quipnetTextValue" format="color" />
    <!-- Роль D — подпись под названием. -->
    <attr name="quipnetTextHint" format="color" />

    <attr name="quipnetSwitchOn" format="color" />
    <attr name="quipnetSwitchOff" format="color" />
    <attr name="quipnetSwitchThumbOn" format="color" />
    <attr name="quipnetSwitchThumbOff" format="color" />

    <attr name="quipnetIconTint" format="color" />
    <attr name="m3ColorIconTint" format="color" />

    <!-- Элевация Material 3 Expressive — именованные ступени для компонентов. -->
    <attr name="elevationLevel0" format="dimension" />
    <attr name="elevationLevel1" format="dimension" />
    <attr name="elevationLevel2" format="dimension" />
    <attr name="elevationLevel3" format="dimension" />
    <attr name="elevationLevel4" format="dimension" />
    <attr name="elevationLevel8" format="dimension" />
    <attr name="elevationLevel12" format="dimension" />

    <!-- Формы Material 3 Expressive — скругления small/medium/large. -->
    <attr name="shapeSmall" format="dimension" />
    <attr name="shapeMedium" format="dimension" />
    <attr name="shapeLarge" format="dimension" />
    <attr name="shapeExtraLarge" format="dimension" />

    <!-- Фон и цвет на фоне (стандартные роли, но нужны как кастомные атрибуты
         для совместимости с текущей версией Material Components). -->
    <attr name="colorBackground" format="color" />
    <attr name="colorOnBackground" format="color" />

</resources>
