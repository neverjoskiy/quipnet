<?xml version="1.0" encoding="utf-8"?>
<!--
  Конфигурации WARP — Material 3 Expressive.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/m3ColorBackground"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="Конфигурации"
        android:textColor="?attr/m3ColorPrimary"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textAppearance="?attr/textAppearanceHeadlineLarge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/row_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title">

        <TextView
            android:id="@+id/btn_create_new"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_expressive_filled"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:singleLine="true"
            android:text="Сгенерировать новые"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_paste_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_expressive_filled_tonal"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:singleLine="true"
            android:text="Управление конфигурациями"
            android:textColor="?attr/m3ColorOnSecondaryContainer"
            android:textSize="16sp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/btn_adapt_network"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_expressive_filled_tonal"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:singleLine="true"
            android:text="Перепроверить профили"
            android:textColor="?attr/m3ColorOnSecondaryContainer"
            android:textSize="16sp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />

        <!--
            Источник профилей — выбор из двух, а не тумблер.

            Группа именно FlowRadioGroup: «Конфигурации:» плюс две подписи в
            строку на телефоне не помещаются, обычный RadioGroup — это
            LinearLayout, переносить он не умеет, и «Импортированные» обрезалось
            бы по краю. Обе кнопки остаются прямыми детьми одной группы, иначе
            взаимное исключение перестаёт работать.
        -->
        <LinearLayout
            android:id="@+id/row_configs_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_expressive"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_configs_source_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:text="Конфигурации:"
                android:textColor="?attr/m3ColorOnSurfaceContainer"
                android:textSize="15sp"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <com.example.quipnet.FlowRadioGroup
                android:id="@+id/rg_configs_source"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_configs_builtin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:buttonTint="?attr/m3ColorPrimary"
                    android:maxLines="1"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="Встроенные"
                    android:textColor="?attr/m3ColorOnSurfaceContainer"
                    android:textSize="14sp"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <RadioButton
                    android:id="@+id/rb_configs_imported"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="?attr/m3ColorPrimary"
                    android:maxLines="1"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="Импортированные"
                    android:textColor="?attr/m3ColorOnSurfaceContainer"
                    android:textSize="14sp"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />
            </com.example.quipnet.FlowRadioGroup>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_discovery_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:text="Готово к проверке"
        android:textColor="?attr/m3ColorOnSurfaceContainer"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/row_actions" />

    <TextView
        android:id="@+id/tv_discovery_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:text="Успешных: 0"
        android:textColor="?attr/m3ColorPrimary"
        android:textSize="13sp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_discovery_status" />

    <com.example.quipnet.WarpDiscoveryTrailView
        android:id="@+id/view_discovery_trail"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@id/tv_discovery_progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_discovery_progress"
        app:layout_constraintTop_toTopOf="@id/tv_discovery_progress" />

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="sans-serif"
        android:text="Пока нет встроенных конфигураций."
        android:textColor="?attr/m3ColorOnSurfaceContainer"
        android:textSize="14sp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_config_search" />

    <EditText
        android:id="@+id/et_config_search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/field_expressive"
        android:hint="Поиск: хост, порт, режим"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:minHeight="56dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="?attr/m3ColorOnSurfaceContainer"
        android:textColorHint="?attr/m3ColorOnSurfaceContainer"
        android:textSize="14sp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_discovery_progress" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_configs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_config_search" />

</androidx.constraintlayout.widget.ConstraintLayout>
