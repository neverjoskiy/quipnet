<?xml version="1.0" encoding="utf-8"?>
<!--
  Фон главного экрана — Material 3 Expressive.
  Цвета, типографика, переключатели — из Theme.QuipNet.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/m3ColorBackground"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Фон главного экрана"
            android:textColor="?attr/m3ColorOnBackground"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textAppearance="?attr/textAppearanceHeadlineLarge" />

        <TextView
            android:id="@+id/tv_background_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Фактура берётся из «Темы оформления» и красится её акцентом. Без фактуры фон чёрный. Анимация не реагирует на касания и экономит ресурсы."
            android:textColor="?attr/m3ColorOnBackground"
            android:textSize="14sp"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/rg_main_background_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/m3ColorSurfaceContainer"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/m3ColorOutlineVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingTop="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="16dp">

                <RadioButton
                    android:id="@+id/rb_background_animation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="?attr/m3ColorPrimary"
                    android:text="Использовать анимацию"
                    android:textColor="?attr/m3ColorOnSurfaceContainer"
                    android:textSize="16sp"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <RadioButton
                    android:id="@+id/rb_background_image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="?attr/m3ColorPrimary"
                    android:text="Использовать фактуру"
                    android:textColor="?attr/m3ColorOnSurfaceContainer"
                    android:textSize="16sp"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <RadioButton
                    android:id="@+id/rb_background_none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="?attr/m3ColorPrimary"
                    android:text="Без фона"
                    android:textColor="?attr/m3ColorOnSurfaceContainer"
                    android:textSize="16sp"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
