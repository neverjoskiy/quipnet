<?xml version="1.0" encoding="utf-8"?>
<!--
  Настройка DNS — Material 3 Expressive.
  Цвета, типографика, карточки, поля ввода, переключатели — из Theme.QuipNet.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:background="?attr/m3ColorBackground"
    android:paddingLeft="16dp"
    android:paddingTop="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Настройка DNS"
            android:textColor="?attr/m3ColorOnBackground"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textAppearance="?attr/textAppearanceHeadlineLarge" />

        <TextView
            android:id="@+id/tv_dns_runtime_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Автовыбор DNS для VPN и приложений"
            android:textColor="?attr/m3ColorOnBackground"
            android:textSize="14sp"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <!-- Карта глобального DNS -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/m3ColorSurfaceContainer"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/m3ColorOutlineVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingTop="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="16dp">

                <Switch
                    android:id="@+id/sw_global_dns"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Использовать свой DNS для VPN"
                    android:textColor="?attr/m3ColorOnSurfaceContainer"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:id="@+id/tv_dns_rules_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Резолверы опрашиваются сверху вниз, все — шифрованные. Последняя строка — открытый резолвер провайдера: он отвечает, только когда не ответил ни один защищённый, и его можно выключить. Нажмите «Изменить порядок», чтобы переставить строки и добавить свой резолвер; нажатие на строку меняет адрес."
                    android:textColor="?attr/m3ColorOnSurfaceContainer"
                    android:textSize="12sp"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <TextView
                    android:id="@+id/tv_dns_private_dns_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="?attr/m3ColorError"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btn_dns_reorder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/btn_expressive_filled_tonal"
                    android:gravity="center"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="Изменить порядок"
                    android:textColor="?attr/m3ColorOnSecondaryContainer"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAppearance="?attr/textAppearanceLabelLarge" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_dns_rules"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_marginTop="14dp"
                    android:clipToPadding="false"
                    android:overScrollMode="ifContentScrolls"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />

                <TextView
                    android:id="@+id/btn_add_dns_rule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/btn_expressive_filled_tonal"
                    android:gravity="center"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="Добавить резолвер"
                    android:textColor="?attr/m3ColorOnSecondaryContainer"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAppearance="?attr/textAppearanceLabelLarge" />

                <TextView
                    android:id="@+id/btn_reset_dns_rules"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/btn_expressive_text"
                    android:padding="8dp"
                    android:text="Сбросить к умолчаниям"
                    android:textColor="?attr/m3ColorPrimary"
                    android:textSize="13sp"
                    android:textAppearance="?attr/textAppearanceLabelMedium" />

                <RadioGroup
                    android:id="@+id/rg_dns_route_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <RadioButton
                        android:id="@+id/rb_dns_route_fastest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AUTO"
                        android:textColor="?attr/m3ColorOnSurfaceContainer"
                        android:buttonTint="?attr/m3ColorPrimary"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <RadioButton
                        android:id="@+id/rb_dns_route_direct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Напрямую провайдеру"
                        android:textColor="?attr/m3ColorOnSurfaceContainer"
                        android:buttonTint="?attr/m3ColorPrimary"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <RadioButton
                        android:id="@+id/rb_dns_route_tunnel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Через VPN"
                        android:textColor="?attr/m3ColorOnSurfaceContainer"
                        android:buttonTint="?attr/m3ColorPrimary"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Карта DNS для приложения -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/m3ColorSurfaceContainer"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/m3ColorOutlineVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingTop="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="16dp">

                <Switch
                    android:id="@+id/sw_app_override_dns"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Отдельный DNS для приложения"
                    android:textColor="?attr/m3ColorOnSurfaceContainer"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:id="@+id/tv_selected_dns_app"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Выбрано приложение: пока не выбрано"
                    android:textColor="?attr/m3ColorOnSurfaceContainer"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <TextView
                    android:id="@+id/btn_pick_dns_app"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/btn_expressive_filled_tonal"
                    android:gravity="center"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="Выбрать приложение"
                    android:textColor="?attr/m3ColorOnSecondaryContainer"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAppearance="?attr/textAppearanceLabelLarge" />

                <EditText
                    android:id="@+id/et_dns_app_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/field_expressive"
                    android:hint="Поиск приложения"
                    android:inputType="text"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp"
                    android:textColor="?attr/m3ColorOnSurfaceContainer"
                    android:textColorHint="?attr/m3ColorOnSurfaceContainer"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_dns_apps"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:layout_marginTop="14dp"
                    android:clipToPadding="false"
                    android:overScrollMode="ifContentScrolls"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/et_app_fallback_dns"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/field_expressive"
                    android:hint="DoH/DoT через запятую"
                    android:inputType="text"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp"
                    android:textColor="?attr/m3ColorOnSurfaceContainer"
                    android:textColorHint="?attr/m3ColorOnSurfaceContainer"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <EditText
                    android:id="@+id/et_app_primary_dns"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/field_expressive"
                    android:hint="Обычный DNS через запятую"
                    android:inputType="text"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp"
                    android:textColor="?attr/m3ColorOnSurfaceContainer"
                    android:textColorHint="?attr/m3ColorOnSurfaceContainer"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <Switch
                    android:id="@+id/sw_app_plain_fallback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="12dp"
                    android:checked="true"
                    android:text="Fallback на обычный DNS"
                    android:textColor="?attr/m3ColorOnSurfaceContainer"
                    android:textSize="14sp"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
