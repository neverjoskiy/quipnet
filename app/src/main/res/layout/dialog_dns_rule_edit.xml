<?xml version="1.0" encoding="utf-8"?>
<!--
  Диалог добавления и правки резолвера — Material 3 Expressive.
  Цвета взяты из темы, а не заданы числом.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/m3ColorSurfaceContainer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="20dp"
        android:paddingRight="24dp"
        android:paddingBottom="20dp">

        <RadioGroup
            android:id="@+id/rg_dns_rule_kind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_dns_rule_any"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="sans-serif"
                android:text="Любой"
                android:textColor="?attr/m3ColorOnSurfaceContainer"
                android:buttonTint="?attr/m3ColorPrimary"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <RadioButton
                android:id="@+id/rb_dns_rule_doh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="sans-serif"
                android:text="DoH"
                android:textColor="?attr/m3ColorOnSurfaceContainer"
                android:buttonTint="?attr/m3ColorPrimary"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <RadioButton
                android:id="@+id/rb_dns_rule_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="DoT"
                android:textColor="?attr/m3ColorOnSurfaceContainer"
                android:buttonTint="?attr/m3ColorPrimary"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
        </RadioGroup>

        <EditText
            android:id="@+id/et_dns_rule_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/field_expressive"
            android:fontFamily="sans-serif"
            android:hint="Адрес резолвера"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="2"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:textColor="?attr/m3ColorOnSurfaceContainer"
            android:textColorHint="?attr/m3ColorOnSurfaceContainer"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:id="@+id/tv_dns_rule_value_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:textColor="?attr/m3ColorError"
            android:textSize="12sp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif"
            android:text="Адреса, по которым приложение дозванивается до имени резолвера, подставляются автоматически."
            android:textColor="?attr/m3ColorOnSurfaceContainer"
            android:textSize="11sp"
            android:textAppearance="?attr/textAppearanceBodySmall" />
    </LinearLayout>
</ScrollView>
