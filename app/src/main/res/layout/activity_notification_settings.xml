<?xml version="1.0" encoding="utf-8"?>
<!--
  Настройки уведомлений — Material 3 Expressive.
  Цвета, типографика, карточки, переключатели — из Theme.QuipNet.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/m3ColorBackground"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Уведомление"
            android:textColor="?attr/m3ColorOnBackground"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textAppearance="?attr/textAppearanceHeadlineLarge" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/m3ColorSurfaceContainer"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/m3ColorOutlineVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Скорость и транспорт"
                        android:textColor="?attr/m3ColorOnSurfaceContainer"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Показывать в шторке скорость обмена и текущий регион с протоколом"
                        android:textColor="?attr/m3ColorOnSurfaceContainer"
                        android:textSize="12sp"
                        android:textAppearance="?attr/textAppearanceBodySmall" />
                </LinearLayout>

                <Switch
                    android:id="@+id/sw_notification_details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/m3ColorSurfaceContainer"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/m3ColorOutlineVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Свернуть уведомление"
                        android:textColor="?attr/m3ColorOnSurfaceContainer"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Узкая строка без кнопки «Отключить» — она появится, если развернуть карточку"
                        android:textColor="?attr/m3ColorOnSurfaceContainer"
                        android:textSize="12sp"
                        android:textAppearance="?attr/textAppearanceBodySmall" />
                </LinearLayout>

                <Switch
                    android:id="@+id/sw_notification_collapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_notification_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="?attr/m3ColorOnSurfaceContainer"
            android:textSize="12sp"
            android:textAppearance="?attr/textAppearanceBodySmall" />
    </LinearLayout>
</ScrollView>
