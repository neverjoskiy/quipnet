<?xml version="1.0" encoding="utf-8"?>
<!--
  Прямой поток — Material 3 Expressive.
  Цвета, типографика, карточки, переключатели, поиск — из Theme.QuipNet.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/m3ColorBackground"
    android:padding="16dp">

    <!-- Заголовок экрана -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Прямой поток"
        android:textColor="?attr/m3ColorOnBackground"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textAppearance="?attr/textAppearanceHeadlineLarge" />

    <!-- Подсказка: главное про экран — правило действует во всех режимах -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Эти приложения идут мимо туннеля в любом режиме раздельного туннелирования. Изменения применяются к текущему сеансу."
        android:textColor="?attr/m3ColorOnBackground"
        android:textSize="14sp"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <!-- Мастер-переключатель закрытого российского списка -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="?attr/m3ColorSurfaceContainer"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/m3ColorOutlineVariant">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingTop="12dp"
            android:paddingRight="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Российские приложения мимо туннеля"
                android:textColor="?attr/m3ColorOnSurfaceContainer"
                android:textSize="16sp"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <Switch
                android:id="@+id/sw_direct_russian"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Живая сводка: сколько строк из списка и сколько выбрано руками -->
    <TextView
        android:id="@+id/tv_direct_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="?attr/m3ColorOnSurfaceContainer"
        android:textSize="13sp"
        android:textAppearance="?attr/textAppearanceBodySmall" />

    <EditText
        android:id="@+id/et_direct_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/field_expressive"
        android:hint="Поиск приложений..."
        android:inputType="text"
        android:textColor="?attr/m3ColorOnSurfaceContainer"
        android:textColorHint="?attr/m3ColorOnSurfaceContainer"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Системные приложения"
            android:textColor="?attr/m3ColorOnSurfaceContainer"
            android:textSize="14sp"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <Switch
            android:id="@+id/sw_direct_show_system"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_direct_apps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1" />

</LinearLayout>
