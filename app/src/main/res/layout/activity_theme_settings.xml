<?xml version="1.0" encoding="utf-8"?>
<!--
  Экран «Оформление» — Material 3 Expressive.

  Каждое изменение видно сразу, ещё до «Применить»: экран пересоздаёт себя с
  предпросмотром (`QuipNetAppearance.preview`). «Отмена» и уход назад
  предпросмотр снимают, поэтому передумать ничего не стоит.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/m3ColorBackground"
    android:paddingLeft="16dp"
    android:paddingTop="16dp"
    android:paddingRight="16dp">

    <ScrollView
        android:id="@+id/sv_theme_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Оформление"
                android:textColor="?attr/m3ColorOnBackground"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textAppearance="?attr/textAppearanceHeadlineLarge" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Всё видно сразу — «Применить» только сохраняет выбор."
                android:textColor="?attr/m3ColorOnBackground"
                android:textSize="14sp"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <!-- Тема -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/m3ColorSurfaceContainer"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/m3ColorOutlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="16dp"
                    android:paddingTop="16dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Тема"
                        android:textColor="?attr/m3ColorOnSurfaceContainer"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <TextView
                        android:id="@+id/tv_theme_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="6dp"
                        android:textColor="?attr/m3ColorOnSurfaceContainer"
                        android:textSize="12sp"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <com.example.quipnet.FlowRadioGroup
                        android:id="@+id/rg_theme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Фактура -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/m3ColorSurfaceContainer"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/m3ColorOutlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="16dp"
                    android:paddingTop="16dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Фактура"
                        android:textColor="?attr/m3ColorOnSurfaceContainer"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="6dp"
                        android:text="Узор поверхности. Цвет ему даёт акцент выбранной темы. Нажмите на выбранную ещё раз — узор построится заново."
                        android:textColor="?attr/m3ColorOnSurfaceContainer"
                        android:textSize="12sp"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <com.example.quipnet.FlowRadioGroup
                        android:id="@+id/rg_texture"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Температура -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/m3ColorSurfaceContainer"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/m3ColorOutlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="16dp"
                    android:paddingTop="16dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Температура"
                            android:textColor="?attr/m3ColorOnSurfaceContainer"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <TextView
                            android:id="@+id/tv_temperature_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/m3ColorPrimary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/sb_temperature"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:progressTint="?attr/m3ColorPrimary"
                        android:thumbTint="?attr/m3ColorPrimary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Тёплая"
                            android:textColor="?attr/m3ColorOnSurfaceContainer"
                            android:textSize="11sp"
                            android:textAppearance="?attr/textAppearanceBodySmall" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Холодная"
                            android:textColor="?attr/m3ColorOnSurfaceContainer"
                            android:textSize="11sp"
                            android:textAppearance="?attr/textAppearanceBodySmall" />
                    </LinearLayout>

                    <!--
                        Вернуть нейтраль. Ползунок в 201 положение пальцем в середину
                        не ставится, а «нейтрально» — единственное значение, которое
                        надо уметь вернуть точно.
                    -->
                    <TextView
                        android:id="@+id/btn_temperature_default"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/btn_expressive_text"
                        android:text="По умолчанию"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:textColor="?attr/m3ColorPrimary"
                        android:textAppearance="?attr/textAppearanceLabelMedium" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
