<?xml version="1.0" encoding="utf-8"?>
<!--
  Главный экран VPN — Material 3 Expressive.
  Цвета, типографика, формы и elevation берутся из Theme.QuipNet (M3 tonal palette,
  type scale, скругления small/medium/large, elevation ступени).
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/m3ColorBackground"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".MainActivity">

    <!-- Фоновая анимация и фон экрана (оставлены как есть — кастомные View). -->
    <com.example.quipnet.BackdropRevealImageView
        android:id="@+id/iv_background_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.quipnet.QuipNetNetworkBackgroundView
        android:id="@+id/quipnet_background_animation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.quipnet.TronRingsView
        android:id="@+id/tron_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Граница колонок горизонтальной раскладки. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_main_split"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.62" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_main_log"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.25" />

    <!--
      Статус VPN — выразительная типографика (HeadlineLarge), цвет из палитры.
      Leжит в карточке со скруглением large и elevation.
    -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="?attr/m3ColorSurfaceContainer"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/m3ColorOutlineVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.example.quipnet.StrokeTextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="НЕ ПОДКЛЮЧЕНО"
            android:textColor="?attr/m3ColorError"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.082"
            android:breakStrategy="balanced"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Предупреждение под статусом (DNS-канал и т.п.). -->
    <TextView
        android:id="@+id/tv_dns_mode_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginTop="8dp"
        android:textColor="?attr/m3ColorOnSurfaceContainer"
        android:alpha="0.75"
        android:textSize="12sp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_status" />

    <!-- Микро-лог подключения. -->
    <LinearLayout
        android:id="@+id/ll_micro_log"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_dns_mode_notice">

        <TextView
            android:id="@+id/tv_micro_event"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:saveEnabled="false"
            android:text=""
            android:textColor="?attr/m3ColorPrimary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_transport_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="3"
            android:saveEnabled="false"
            android:text=""
            android:textColor="?attr/m3ColorScarf"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_profile_issue_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:saveEnabled="false"
            android:text=""
            android:textColor="?attr/m3ColorOnPrimaryContainer"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvAttemptProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text=""
            android:textColor="?attr/m3ColorOnBackground"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:visibility="invisible" />

        <com.example.quipnet.SlidingDotsIndicatorView
            android:id="@+id/restricted_mobile_dots"
            android:layout_width="74dp"
            android:layout_height="11dp"
            android:layout_marginTop="6dp"
            android:visibility="gone" />
    </LinearLayout>

    <!--
      Кнопка подключения — Material 3 Expressive Elevated Button.
      Крупные пропорции: 56dp высота, пилюлевидная форма, elevation 4dp.
      Выровнена по центру экрана (геометрический центр).
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConnect"
        style="@style/Widget.QuipNet.Button.Elevated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ПОДКЛЮЧИТЬ"
        android:textColor="#000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Подпись над кнопкой «след. профиль». -->
    <TextView
        android:id="@+id/tv_next_profile_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:gravity="center"
        android:text="след. профиль"
        android:textColor="?attr/m3ColorOnSurfaceContainer"
        android:textSize="10sp"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/btnNextProfile"
        app:layout_constraintEnd_toEndOf="@+id/btnNextProfile" />

    <!-- Кнопка следующего профиля — малая Expressive кнопка (пилюля). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNextProfile"
        style="@style/Widget.QuipNet.Button.Filled"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:text="&gt;"
        android:textColor="#000000"
        app:layout_constraintBottom_toBottomOf="@id/btnConnect"
        app:layout_constraintTop_toTopOf="@id/btnConnect"
        app:layout_constraintStart_toEndOf="@id/btnConnect"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Плашка обновления (вверху справа). -->
    <com.example.quipnet.UpdateChipView
        android:id="@+id/btn_install_update"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="25dp"
        android:paddingTop="22dp"
        android:paddingEnd="27dp"
        android:paddingBottom="22dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_update_icon"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_update_chrome" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_update_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.01"
                android:text="Обновить"
                android:textColor="?attr/m3ColorOnPrimaryContainer"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_update_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.02"
                android:textColor="?attr/m3ColorScarf"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </com.example.quipnet.UpdateChipView>

    <!-- Label пинга (над графиком, справа). -->
    <TextView
        android:id="@+id/tv_internet_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:lineSpacingExtra="2dp"
        android:text="Ping:&#10;---"
        android:textColor="?attr/m3ColorOnBackground"
        android:textSize="14sp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        app:layout_constraintTop_toTopOf="@+id/ll_ip_row"
        app:layout_constraintEnd_toEndOf="@+id/graph_latency" />

    <!-- Бейдж страны. -->
    <TextView
        android:id="@+id/tv_country_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:saveEnabled="false"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_country_badge"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:text="WARP: --"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/btn_settings"
        app:layout_constraintEnd_toEndOf="@+id/graph_latency" />

    <!--
      Выбор протокола/региона на главном экране (Material 3 Expressive).
      Чипы региона — обновлённые стили с M3 цветами.
    -->
    <LinearLayout
        android:id="@+id/sv_exit_region_main"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnConnect"
        app:layout_constraintBottom_toTopOf="@+id/btn_settings"
        app:layout_constraintVertical_bias="0">

        <HorizontalScrollView
            android:id="@+id/hsv_exit_region"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">

            <com.example.quipnet.FlowRadioGroup
                android:id="@+id/rg_exit_region"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_exit_auto"
                    style="@style/QuipNetMainRegionChip"
                    android:text="AUTO" />

                <RadioButton
                    android:id="@+id/rb_exit_ru"
                    style="@style/QuipNetMainRegionChip"
                    android:text="WARP" />

                <RadioButton
                    android:id="@+id/rb_exit_masque"
                    style="@style/QuipNetMainRegionChip"
                    android:text="MASQUE" />

                <RadioButton
                    android:id="@+id/rb_exit_opera"
                    style="@style/QuipNetMainRegionChip"
                    android:text="OPERA" />

                <RadioButton
                    android:id="@+id/rb_exit_proton"
                    style="@style/QuipNetMainRegionChip"
                    android:text="PROTON" />

                <RadioButton
                    android:id="@+id/rb_exit_tor"
                    style="@style/QuipNetMainRegionChip"
                    android:text="TOR" />

                <RadioButton
                    android:id="@+id/rb_exit_dns"
                    style="@style/QuipNetMainRegionChip"
                    android:text="DNS" />
            </com.example.quipnet.FlowRadioGroup>
        </HorizontalScrollView>

        <!-- Четвёртая строка: подрегион выбранного транспорта. -->
        <LinearLayout
            android:id="@+id/ll_exit_sub_region"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|start"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_exit_sub_region_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Регион:"
                android:textColor="?attr/m3ColorOnSurfaceContainer"
                android:textSize="11sp"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <TextView
                android:id="@+id/tv_exit_dot_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_region_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="Отключите DoT"
                android:textColor="#FFD166"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.example.quipnet.FlowRadioGroup
                    android:id="@+id/rg_exit_sub_region"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <com.example.quipnet.FlowRadioGroup
            android:id="@+id/rg_imported_protocol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_imported_profiles"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_settings_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="112dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Импортированные профили (0) ▾"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Строка под селектором (причина запрета, выпуск Proton, состояние Tor). -->
    <TextView
        android:id="@+id/tv_exit_last"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="?attr/m3ColorOnSurfaceContainer"
        android:textSize="12sp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sv_exit_region_main" />

    <!-- Кнопка настроек — Expressive Text Button. -->
    <TextView
        android:id="@+id/btn_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:minWidth="112dp"
        android:text="⚙️ Настройки"
        android:textColor="?attr/m3ColorPrimary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:gravity="center"
        android:background="@drawable/bg_settings_button"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_ip_row"
        app:layout_constraintStart_toStartOf="@+id/graph_latency"/>

    <!-- Кнопка языка — Expressive Text Button. -->
    <TextView
        android:id="@+id/btn_language"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_settings_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="64dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="🌍 RU"
        android:textColor="?attr/m3ColorPrimary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        app:layout_constraintBottom_toBottomOf="@+id/btn_settings"
        app:layout_constraintStart_toEndOf="@+id/btn_settings"
        app:layout_constraintTop_toTopOf="@+id/btn_settings" />

    <!--
      Строка адресов (IP) слева от пинга. Ширина по содержимому, не заходит на пинг.
    -->
    <LinearLayout
        android:id="@+id/ll_ip_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="0dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/graph_latency"
        app:layout_constraintEnd_toStartOf="@+id/tv_internet_label"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/graph_latency">

        <TextView
            android:id="@+id/tv_ip_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:saveEnabled="false"
            android:background="@drawable/bg_ip_label"
            android:ellipsize="end"
            android:gravity="start"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:minLines="2"
            android:text="...&#10;..."
            android:textColor="?attr/m3ColorPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- График задержки (LatencyGraphView) — в карточке с elevation. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_latency"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="?attr/m3ColorSurfaceContainer"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/m3ColorOutlineVariant"
        app:layout_constraintBottom_toTopOf="@+id/tv_version"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.example.quipnet.LatencyGraphView
            android:id="@+id/graph_latency"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_latency_graph" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Пояснение вместо пинга в режиме DNS (лежит поверх шкалы graph_latency). -->
    <TextView
        android:id="@+id/tv_dns_ping_notice"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:saveEnabled="false"
        android:textColor="?attr/m3ColorOnSurfaceContainer"
        android:textSize="11sp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/graph_latency"
        app:layout_constraintEnd_toEndOf="@+id/graph_latency"
        app:layout_constraintStart_toStartOf="@+id/graph_latency"
        app:layout_constraintTop_toTopOf="@+id/graph_latency" />

    <!-- Версия приложения (нижний левый угол графиков). -->
    <TextView
        android:id="@+id/tv_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="16dp"
        android:text="v1.33.1"
        android:textColor="?attr/m3ColorOnSurfaceContainer"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textAppearance="?attr/textAppearanceBodySmall"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/graph_latency" />

    <!--
      Лёд кладётся ПОСЛЕДНИМ ребёнком намеренно — поверх всего интерфейса.
      Касания сквозь него проходят (см. FrostOverlayView.onTouchEvent).
    -->
    <com.example.quipnet.FrostOverlayView
        android:id="@+id/frost_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
